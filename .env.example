# LinkHive prototype — environment variables
#
# This prototype has no backend and makes no network requests. It needs no
# secrets, no API keys and no service credentials.
#
# Every value below is a local development default. Nothing here is read by
# the application today. They exist so that the shape of a future integration
# is written down before it is built.
#
# Copy to `.env.local` only if you need to override something locally.
# `.env` and `.env.local` are git-ignored. Never commit real credentials.

# --- Local development -------------------------------------------------------
# The port the dev server listens on. The host is always 0.0.0.0 so a preview
# can reach it.
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# --- Mock identity -----------------------------------------------------------
# The prototype uses a single fixed mock person. Changing this changes nothing
# yet: it records the intent so the future sign-in service has a seam.
VITE_MOCK_USER_ID=user-you

# --- Future verification provider -------------------------------------------
# Not connected. The demo verification flow uses fake samples only and never
# calls an external service.
VITE_VERIFICATION_PROVIDER=none
VITE_VERIFICATION_API_URL=
VITE_VERIFICATION_API_KEY=

# --- Future messaging and notification transports ----------------------------
# Not connected. Messages and notifications are stored in local state only.
VITE_MESSAGING_PROVIDER=none
VITE_MESSAGING_API_URL=
VITE_MESSAGING_API_KEY=
VITE_NOTIFICATION_PROVIDER=none

# --- Future payments and settlement -----------------------------------------
# Not connected, and deliberately so. The prototype implements no payment flow,
# wallet, currency conversion, credit or cash-out.
VITE_PAYMENT_PROVIDER=none
VITE_PAYMENT_API_URL=
VITE_PAYMENT_API_KEY=
VITE_SETTLEMENT_MODEL=under-research
